# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Google Custom Search ──────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_DB_TYPE=chromadb
CHROMADB_PERSIST_DIRECTORY=./data/chroma_db
CHROMADB_COLLECTION_NAME=financial_docs

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_EMBEDDING_MODEL=nomic-embed-text

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_LLM_MODEL=qwen2.5:latest
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=10
AGENT_SYSTEM_PROMPT="You are a senior financial analyst. When given financial statements and data, produce a structured, professional analysis. Cover: revenue and profit trends, cash flow health, balance sheet strength, key ratios (P/E, debt-to-equity, operating margin, ROE where data allows), and a concise investment summary with risks and outlook. Be factual, cite specific numbers, and base all conclusions strictly on the provided data."

# ── API ───────────────────────────────────────────────────────────────────────
API_SERVICE_TITLE="Sample APP"
API_VERSION="0.0.1"
API_HOST=0.0.0.0
API_PORT=8081
API_WORKERS=4

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=json